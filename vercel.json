{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "rewrites": [
    { "source": "/collections", "destination": "/index.html" },
    { "source": "/account", "destination": "/index.html" },
    { "source": "/profile", "destination": "/index.html" },
    { "source": "/orders", "destination": "/index.html" },
    { "source": "/orders/:path*", "destination": "/index.html" },
    { "source": "/addresses", "destination": "/index.html" },
    { "source": "/payment-methods", "destination": "/index.html" },
    { "source": "/wishlist", "destination": "/index.html" },
    { "source": "/checkout/:path*", "destination": "/index.html" },
    { "source": "/search", "destination": "/index.html" },
    { "source": "/search/:path*", "destination": "/index.html" },
    { "source": "/shipping", "destination": "/index.html" },
    { "source": "/returns", "destination": "/index.html" },
    { "source": "/contact", "destination": "/index.html" },
    { "source": "/privacy", "destination": "/index.html" },
    { "source": "/register", "destination": "/index.html" },
    { "source": "/forgot-password", "destination": "/index.html" },
    { "source": "/science", "destination": "/index.html" },
    { "source": "/routine-guide", "destination": "/index.html" }
  ]
}
